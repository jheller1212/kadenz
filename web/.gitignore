# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# static export for the native shell: the staging tree it builds in
/.shell-build/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google Calendar OAuth tokens (sensitive, do not commit)
.gcal-tokens.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e (Playwright) — local-only Postgres data dir, minted test sessions, and
# the cross-user-isolation spec's seed-ids/cookies artifacts
/e2e/.pgdata/
/e2e/.auth/
/e2e/.artifacts/
/playwright-report/
/test-results/
